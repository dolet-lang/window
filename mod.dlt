# ============================
#  Dolet Native Window Library
# ============================
# Target-neutral public window API with platform-specific backends.
module window
load window/constants
load window/platform/{platform}/software_surface
# load window/platform/{platform}/timing  <!-- Commented: f64 not yet supported in self-hosted compiler -->
load window/platform/{platform}/core

# Exported structs - public window package API
# export TimeState  <!-- Commented -->
export Window
export WindowEvent
export WindowSoftwareSurface

# Exported functions - window/cursor
export WndProc
export set_cursor_visible
export is_cursor_visible
export set_cursor_locked
export is_cursor_locked
export set_cursor_position
export window_center_mouse
export window_set_mode
export window_mode
export WINDOW_MODE_WINDOWED
export WINDOW_MODE_FULLSCREEN
export WINDOW_MODE_BORDERLESS_FULLSCREEN
export window_clear_mouse_delta
export WINDOW_EVENT_NONE
export WINDOW_EVENT_CLOSE
export WINDOW_EVENT_RESIZE
export WINDOW_EVENT_FOCUS

# Exported functions - raw event accessors (drain-on-read).
# Callers forward these into their chosen input package each frame.
export window_consume_wheel_delta
export window_consume_mouse_delta_x
export window_consume_mouse_delta_y
export window_consume_typed_chars
export window_consume_backspace
export window_key_down
export window_mouse_button_down
export window_backend
export window_backend_name

# Exported functions - framebuffer present + client-mouse
# (so drawing/UI packages don't need to declare Win32 externs themselves)
export window_present_framebuffer
export window_client_mouse_position
export window_client_mouse_x
export window_client_mouse_y
