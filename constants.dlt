# ============================
#  Dolet Window Public Constants
# ============================
# Target-neutral constants exposed by the window package.

# ----- Window Modes -----
WINDOW_MODE_WINDOWED: i32 = 0
WINDOW_MODE_FULLSCREEN: i32 = 1
WINDOW_MODE_BORDERLESS_FULLSCREEN: i32 = 2

# ----- Window Library Error Codes -----
WINDOW_ERROR_NONE: i32 = 0
WINDOW_ERROR_REGISTER_CLASS: i32 = 1
WINDOW_ERROR_CREATE_WINDOW: i32 = 2
WINDOW_ERROR_INVALID_HANDLE: i32 = 3
WINDOW_ERROR_VULKAN_SURFACE: i32 = 4
WINDOW_ERROR_OUT_OF_MEMORY: i32 = 5
WINDOW_ERROR_INVALID_PARAMETER: i32 = 6

# ----- Key State Constants -----
KEY_STATE_RELEASED: i32 = 0
KEY_STATE_PRESSED: i32 = 1
KEY_STATE_JUST_PRESSED: i32 = 2
KEY_STATE_JUST_RELEASED: i32 = 3

# ----- Maximum Keys to Track -----
MAX_KEYS: i32 = 256

# ----- Window Event Types -----
WINDOW_EVENT_NONE: i32 = 0
WINDOW_EVENT_CLOSE: i32 = 1
WINDOW_EVENT_RESIZE: i32 = 2
WINDOW_EVENT_FOCUS: i32 = 3
