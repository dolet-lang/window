# ============================================================================
# Linux native window backend
# ============================================================================
# The platform bridge selects native Wayland first and falls back to X11.
# Higher layers only see this stable Dolet API and never import either display
# server ABI directly.

extern lib "dolet_window_linux":
    fun dolet_window_open(title: str, width: i32, height: i32) -> i32
    fun dolet_window_close()
    fun dolet_window_poll()
    fun dolet_window_wait_timeout(timeout_ms: i32)
    fun dolet_window_should_close() -> i32
    fun dolet_window_request_close()
    fun dolet_window_width() -> i32
    fun dolet_window_height() -> i32
    fun dolet_window_focused() -> i32
    fun dolet_window_resized() -> i32
    fun dolet_window_reset_resized()
    fun dolet_window_backend() -> i32
    fun dolet_window_backend_name() -> str
    fun dolet_window_handle() -> i64
    fun dolet_window_display() -> i64
    fun dolet_window_next_event(kind: i64, value1: i64, value2: i64) -> i32
    fun dolet_window_consume_wheel() -> f32
    fun dolet_window_consume_mouse_dx() -> i32
    fun dolet_window_consume_mouse_dy() -> i32
    fun dolet_window_consume_typed() -> str
    fun dolet_window_consume_backspace() -> i32
    fun dolet_window_key_down(key: i32) -> i32
    fun dolet_window_mouse_button_down(button: i32) -> i32
    fun dolet_window_clear_mouse_delta()
    fun dolet_window_mouse_x() -> i32
    fun dolet_window_mouse_y() -> i32
    fun dolet_window_set_cursor_visible(visible: i32)
    fun dolet_window_cursor_visible() -> i32
    fun dolet_window_set_cursor_locked(locked: i32)
    fun dolet_window_cursor_locked() -> i32
    fun dolet_window_set_cursor_position(x: i32, y: i32)
    fun dolet_window_center_cursor()
    fun dolet_window_set_title(title: str)
    fun dolet_window_set_mode(mode: i32, width: i32, height: i32) -> i32
    fun dolet_window_mode() -> i32
    fun dolet_window_present(pixels: i64, width: i32, height: i32, pitch: i32) -> i32
    fun dolet_window_vulkan_extension() -> str
    fun dolet_window_create_vulkan_surface(instance: i64) -> i64
    fun dolet_window_destroy_vulkan_surface(instance: i64, surface: i64)
    fun dolet_window_set_size(width: i32, height: i32)
    fun dolet_window_show(visible: i32)

# Native dependencies of the checked-in bridge archive. Keeping these as
# parsed extern declarations makes target selection and linking deterministic;
# comments or module metadata cannot silently alter linker policy.
extern lib "wayland-client":
    fun wl_display_connect(name: str) -> i64

extern lib "wayland-cursor":
    fun wl_cursor_theme_load(name: str, size: i32, shm: i64) -> i64

extern lib "xkbcommon":
    fun xkb_context_new(flags: i32) -> i64

extern lib "X11":
    fun XOpenDisplay(name: str) -> i64

g_last_error: i32 = 0
g_win32_error: i32 = 0
g_window_vulkan_surface: i64 = 0

@stack
struct _WindowCursorPoint:
    x: i32 = 0
    y: i32 = 0

@stack
struct _WindowNativeEvent:
    kind: i32 = 0
    value1: i32 = 0
    value2: i32 = 0

fun WndProc(hWnd: i64, uMsg: i32, wParam: i64, lParam: i64) -> i64:
    return 0

fun window_clear_mouse_delta():
    dolet_window_clear_mouse_delta()

fun window_center_mouse(hwnd: i64):
    dolet_window_center_cursor()

# Display scale as a percentage. The Wayland backend does not yet listen for
# the output scale and X11 is not read for Xft.dpi, so this reports one-to-one
# rather than guessing. An application that knows better sets it outright
# through the framework; nothing here pretends to have detected anything.
fun window_scale_percent() -> i32:
    return 100

fun window_consume_wheel_delta() -> f32:
    return dolet_window_consume_wheel()

fun window_consume_mouse_delta_x() -> i32:
    return dolet_window_consume_mouse_dx()

fun window_consume_mouse_delta_y() -> i32:
    return dolet_window_consume_mouse_dy()

fun window_consume_typed_chars() -> str:
    return dolet_window_consume_typed()

fun window_consume_backspace() -> i32:
    return dolet_window_consume_backspace()

fun window_key_down(key: i32) -> i32:
    return dolet_window_key_down(key)

fun window_mouse_button_down(button: i32) -> i32:
    return dolet_window_mouse_button_down(button)

fun window_backend() -> i32:
    return dolet_window_backend()

fun window_backend_name() -> str:
    return dolet_window_backend_name()

struct WindowEvent:
    hwnd: i64 = 0
    kind: i32 = 0
    value1: i32 = 0
    value2: i32 = 0

fun window_next_event() -> WindowEvent:
    native: _WindowNativeEvent = _WindowNativeEvent()
    if dolet_window_next_event(native as i64, (native as i64) + 4, (native as i64) + 8) == 0:
        return WindowEvent()
    return WindowEvent(
        hwnd=dolet_window_handle(),
        kind=native.kind,
        value1=native.value1,
        value2=native.value2
    )

struct Window:
    handle: i64 = 0
    hinstance: i64 = 0
    width: i32 = 0
    height: i32 = 0
    should_close_flag: i32 = 0
    is_resized: i32 = 0
    is_focused: i32 = 1
    vulkan_surface: i64 = 0

fun make_empty_window() -> Window:
    return Window()

attach Window:
    static fun create(title: str, width: i32, height: i32) -> Window:
        if width <= 0 or height <= 0:
            g_last_error = WINDOW_ERROR_INVALID_PARAMETER
            return make_empty_window()
        if dolet_window_open(title, width, height) == 0:
            g_last_error = WINDOW_ERROR_CREATE_WINDOW
            return make_empty_window()
        g_last_error = WINDOW_ERROR_NONE
        return Window(
            handle=dolet_window_handle(),
            hinstance=dolet_window_display(),
            width=dolet_window_width(),
            height=dolet_window_height(),
            should_close_flag=0,
            is_resized=0,
            is_focused=dolet_window_focused(),
            vulkan_surface=0
        )

    static fun open(title: str, width: i32, height: i32) -> i32:
        if dolet_window_handle() != 0:
            Window.shutdown()
        if dolet_window_open(title, width, height) == 0:
            g_last_error = WINDOW_ERROR_CREATE_WINDOW
            return 0
        g_last_error = WINDOW_ERROR_NONE
        return 1

    static fun shutdown():
        dolet_window_close()
        g_window_vulkan_surface = 0

    static fun poll():
        dolet_window_poll()

    static fun wait():
        dolet_window_wait_timeout(-1)

    static fun wait_timeout(timeout_ms: i32):
        dolet_window_wait_timeout(timeout_ms)

    static fun should_close() -> i32:
        return dolet_window_should_close()

    static fun running() -> i32:
        if dolet_window_should_close() == 0:
            return 1
        return 0

    static fun request_close():
        dolet_window_request_close()

    static fun handle() -> i64:
        return dolet_window_handle()

    static fun hinstance() -> i64:
        return dolet_window_display()

    static fun width() -> i32:
        return dolet_window_width()

    static fun height() -> i32:
        return dolet_window_height()

    static fun set_mode(mode: i32, width: i32, height: i32) -> i32:
        return dolet_window_set_mode(mode, width, height)

    static fun mode() -> i32:
        return dolet_window_mode()

    static fun focused() -> i32:
        return dolet_window_focused()

    static fun next_event() -> WindowEvent:
        return window_next_event()

    fun destroy(self):
        dolet_window_close()
        self.handle = 0
        self.hinstance = 0
        self.width = 0
        self.height = 0
        self.should_close_flag = 1
        self.is_resized = 0
        self.is_focused = 0
        self.vulkan_surface = 0

    fun poll_events(self):
        dolet_window_poll()
        self.handle = dolet_window_handle()
        self.hinstance = dolet_window_display()
        self.width = dolet_window_width()
        self.height = dolet_window_height()
        self.should_close_flag = dolet_window_should_close()
        self.is_resized = dolet_window_resized()
        self.is_focused = dolet_window_focused()

    fun get_width(self) -> i32:
        self.width = dolet_window_width()
        return self.width

    fun get_height(self) -> i32:
        self.height = dolet_window_height()
        return self.height

    fun set_size(self, width: i32, height: i32):
        dolet_window_set_size(width, height)
        self.width = width
        self.height = height

    fun set_title(self, title: str):
        dolet_window_set_title(title)

    fun show(self):
        dolet_window_show(1)

    fun hide(self):
        dolet_window_show(0)

    fun was_resized(self) -> i32:
        self.is_resized = dolet_window_resized()
        if self.is_resized == 1:
            self.width = dolet_window_width()
            self.height = dolet_window_height()
        return self.is_resized

    fun reset_resize_flag(self):
        dolet_window_reset_resized()
        self.is_resized = 0

    fun has_focus(self) -> i32:
        self.is_focused = dolet_window_focused()
        return self.is_focused

    fun get_handle(self) -> i64:
        self.handle = dolet_window_handle()
        return self.handle

    fun get_hinstance(self) -> i64:
        self.hinstance = dolet_window_display()
        return self.hinstance

    fun create_vulkan_surface(self, instance: i64) -> i64:
        if instance == 0 or dolet_window_handle() == 0:
            g_last_error = WINDOW_ERROR_INVALID_HANDLE
            return 0
        self.vulkan_surface = dolet_window_create_vulkan_surface(instance)
        g_window_vulkan_surface = self.vulkan_surface
        if self.vulkan_surface == 0:
            g_last_error = WINDOW_ERROR_VULKAN_SURFACE
        return self.vulkan_surface

    static fun get_required_extension_1() -> str:
        return "VK_KHR_surface"

    static fun get_required_extension_2() -> str:
        return dolet_window_vulkan_extension()

    fun destroy_vulkan_surface(self, instance: i64):
        if instance == 0 or self.vulkan_surface == 0:
            return
        dolet_window_destroy_vulkan_surface(instance, self.vulkan_surface)
        self.vulkan_surface = 0
        g_window_vulkan_surface = 0

    fun create_software_surface(self) -> WindowSoftwareSurface:
        if dolet_window_handle() == 0:
            g_last_error = WINDOW_ERROR_INVALID_HANDLE
            return WindowSoftwareSurface()
        return WindowSoftwareSurface(hwnd=dolet_window_handle(), scratch_buffer=0, scratch_size=0, valid=1)

    fun get_vulkan_surface(self) -> i64:
        return self.vulkan_surface

    fun wait_events(self):
        dolet_window_wait_timeout(-1)

    fun wait_events_timeout(self, timeout_ms: i32):
        dolet_window_wait_timeout(timeout_ms)

fun window_set_mode(mode: i32, width: i32, height: i32) -> i32:
    return dolet_window_set_mode(mode, width, height)

fun window_mode() -> i32:
    return dolet_window_mode()

fun get_last_error() -> i32:
    return g_last_error

fun get_win32_error() -> i32:
    return g_win32_error

fun clear_error():
    g_last_error = WINDOW_ERROR_NONE
    g_win32_error = 0

fun set_error(error_code: i32, win32_error: i32):
    g_last_error = error_code
    g_win32_error = win32_error

fun set_cursor_visible(visible: i32):
    dolet_window_set_cursor_visible(visible)

fun is_cursor_visible() -> i32:
    return dolet_window_cursor_visible()

fun set_cursor_locked(locked: i32, window_handle: i64):
    dolet_window_set_cursor_locked(locked)

fun is_cursor_locked() -> i32:
    return dolet_window_cursor_locked()

fun set_cursor_position(x: i32, y: i32):
    dolet_window_set_cursor_position(x, y)

fun window_present_framebuffer(hwnd: i64, data: i64, width: i32, height: i32, pitch: i32) -> i32:
    return dolet_window_present(data, width, height, pitch)

fun window_client_mouse_position(hwnd: i64, point: i64) -> i32:
    if point == 0 or dolet_window_handle() == 0:
        return 0
    Memory.write_i32(point, dolet_window_mouse_x())
    Memory.write_i32(point + 4, dolet_window_mouse_y())
    return 1

fun window_client_mouse_x(hwnd: i64) -> i32:
    return dolet_window_mouse_x()

fun window_client_mouse_y(hwnd: i64) -> i32:
    return dolet_window_mouse_y()
