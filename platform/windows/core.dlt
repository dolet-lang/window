# ============================
#  Window Component
# ============================
# Core Window struct and management functions
# Requirements: 1.1, 1.2, 1.3, 5.1, 5.2, 5.3, 5.4, 9.1, 9.2
#
# NOTE: Input handling has been moved to the standalone Input Library.
# Use "import input" for keyboard and mouse input functions.

import sys.windows.win32.types
import sys.windows.win32.constants
import sys.windows.win32.user32
import sys.windows.win32.vulkan_surface

# Raw mouse input is private to this backend. Keep it behind the existing
# window_consume_mouse_delta_* API so engines do not depend on Win32 details.
extern lib "window_raw_input":
    fun RegisterRawInputDevices(devices: i64, device_count: i32, device_size: i32) -> i32
    fun GetRawInputData(raw_input: i64, command: i32, data: i64, size: i64, header_size: i32) -> i32
    fun ClientToScreen(hwnd: i64, point: i64) -> i32

# ----- Global Error State -----
g_last_error: i32 = 0
g_win32_error: i32 = 0

# ----- Global Window State -----
g_current_window: i64 = 0
g_window_handle: i64 = 0
g_window_hinstance: i64 = 0
g_class_name_data: i64 = 0
g_class_registered: i32 = 0
g_should_close: i32 = 0
g_window_resized: i32 = 0
g_window_focused: i32 = 1
g_window_width: i32 = 0
g_window_height: i32 = 0
g_window_mode: i32 = WINDOW_MODE_WINDOWED
g_window_saved_style: i64 = 0
g_window_saved_left: i32 = 0
g_window_saved_top: i32 = 0
g_window_saved_right: i32 = 0
g_window_saved_bottom: i32 = 0
g_window_saved_valid: i32 = 0

# ----- Cursor State -----
g_cursor_visible: i32 = 1
g_cursor_locked: i32 = 0

# ----- Event State (owned by window, drained by consumers) -----
# WndProc records events here; callers read them with the consume_*
# getters below. This keeps window self-contained; it does NOT import
# or call into any other Dolet package.
g_wnd_wheel_delta: f32 = 0.0       # accumulated since last consume
g_wnd_mouse_delta_x: i32 = 0        # relative mouse movement accumulated since last consume
g_wnd_mouse_delta_y: i32 = 0
g_wnd_mouse_last_x: i32 = 0
g_wnd_mouse_last_y: i32 = 0
g_wnd_mouse_center_x: i32 = 0
g_wnd_mouse_center_y: i32 = 0
g_wnd_mouse_have_last: i32 = 0
g_wnd_raw_mouse_enabled: i32 = 0
g_wnd_raw_mouse_buffer: i64 = 0
g_wnd_raw_mouse_size: i64 = 0
g_wnd_chars_buf:   i64 = 0          # lazy-allocated 256-byte ring
g_wnd_chars_len:   i32 = 0
g_wnd_had_backspace: i32 = 0

WND_CHARS_CAP: i32 = 256
WND_RAW_INPUT: i32 = 268435459
WND_RAW_MOUSE_TYPE: i32 = 0
WND_RAW_HEADER_SIZE: i32 = 24
WND_RAW_MOUSE_BUFFER_SIZE: i32 = 64

@stack
struct _WindowCursorPoint:
    x: i32 = 0
    y: i32 = 0

@stack
struct _WindowRawInputDevice:
    usage_page: i16 = 0
    usage: i16 = 0
    flags: i32 = 0
    target: i64 = 0

# High-level event queue. WndProc keeps this small and callers drain it from
# their normal app loop with Window.next_event().
g_window_event_capacity: i32 = 64
g_window_event_read: i32 = 0
g_window_event_write: i32 = 0
g_window_event_hwnds: i64 = 0
g_window_event_types: i64 = 0
g_window_event_value1s: i64 = 0
g_window_event_value2s: i64 = 0

# Internal: ensure the chars buffer is allocated
fun _wnd_ensure_chars_buf():
    if g_wnd_chars_buf == 0:
        g_wnd_chars_buf = Memory.malloc_zeroed(WND_CHARS_CAP + 1)

fun window_clear_mouse_delta():
    g_wnd_mouse_delta_x = 0
    g_wnd_mouse_delta_y = 0
    g_wnd_mouse_have_last = 0

fun _window_enable_raw_mouse() -> i32:
    device: _WindowRawInputDevice = _WindowRawInputDevice()
    device.usage_page = 1
    device.usage = 2
    device.flags = 0
    device.target = 0
    if RegisterRawInputDevices(device as i64, 1, 16) == 0:
        g_wnd_raw_mouse_enabled = 0
        return 0
    if g_wnd_raw_mouse_buffer == 0:
        g_wnd_raw_mouse_buffer = Memory.malloc_zeroed(WND_RAW_MOUSE_BUFFER_SIZE)
    if g_wnd_raw_mouse_size == 0:
        g_wnd_raw_mouse_size = Memory.malloc_zeroed(4)
    if g_wnd_raw_mouse_buffer == 0 or g_wnd_raw_mouse_size == 0:
        g_wnd_raw_mouse_enabled = 0
        return 0
    g_wnd_raw_mouse_enabled = 1
    return 1

fun _window_accumulate_raw_mouse(raw_input: i64):
    if g_wnd_raw_mouse_enabled == 0:
        return
    if g_cursor_locked == 0:
        return
    Memory.write_i32(g_wnd_raw_mouse_size, WND_RAW_MOUSE_BUFFER_SIZE)
    read_size: i32 = GetRawInputData(raw_input, WND_RAW_INPUT, g_wnd_raw_mouse_buffer, g_wnd_raw_mouse_size, WND_RAW_HEADER_SIZE)
    if read_size <= 0:
        return
    if Memory.read_i32(g_wnd_raw_mouse_buffer) != WND_RAW_MOUSE_TYPE:
        return
    # RAWINPUTHEADER is 24 bytes on Win64. RAWMOUSE lLastX/lLastY are
    # at offsets 12/16 inside the 24-byte mouse payload.
    g_wnd_mouse_delta_x = g_wnd_mouse_delta_x + Memory.read_i32(g_wnd_raw_mouse_buffer + 36)
    g_wnd_mouse_delta_y = g_wnd_mouse_delta_y + Memory.read_i32(g_wnd_raw_mouse_buffer + 40)

fun _window_raw_mouse_shutdown():
    g_wnd_raw_mouse_enabled = 0
    if g_wnd_raw_mouse_buffer != 0:
        Memory.free(g_wnd_raw_mouse_buffer)
        g_wnd_raw_mouse_buffer = 0
    if g_wnd_raw_mouse_size != 0:
        Memory.free(g_wnd_raw_mouse_size)
        g_wnd_raw_mouse_size = 0

fun _window_clip_cursor_to_client(hwnd: i64) -> i32:
    if hwnd == 0:
        return 0
    rect: RECT = RECT()
    top_left: _WindowCursorPoint = _WindowCursorPoint()
    bottom_right: _WindowCursorPoint = _WindowCursorPoint()
    if GetClientRect(hwnd, rect as i64) == 0:
        return 0
    top_left.x = rect.left
    top_left.y = rect.top
    bottom_right.x = rect.right
    bottom_right.y = rect.bottom
    if ClientToScreen(hwnd, top_left as i64) == 0:
        return 0
    if ClientToScreen(hwnd, bottom_right as i64) == 0:
        return 0
    rect.left = top_left.x
    rect.top = top_left.y
    rect.right = bottom_right.x
    rect.bottom = bottom_right.y
    return ClipCursor(rect as i64)

fun _window_center_cursor(hwnd: i64):
    if hwnd == 0:
        return
    rect: RECT = RECT()
    p: _WindowCursorPoint = _WindowCursorPoint()
    if GetWindowRect(hwnd, rect as i64) == 0:
        return
    SetCursorPos((rect.left + rect.right) / 2, (rect.top + rect.bottom) / 2)
    if GetCursorPos(p as i64) != 0:
        if ScreenToClient(hwnd, p as i64) != 0:
            g_wnd_mouse_center_x = p.x
            g_wnd_mouse_center_y = p.y
            g_wnd_mouse_last_x = p.x
            g_wnd_mouse_last_y = p.y
            g_wnd_mouse_have_last = 1

fun window_center_mouse(hwnd: i64):
    _window_center_cursor(hwnd)

fun _window_save_windowed_state():
    if g_window_handle == 0:
        return
    if g_window_saved_valid == 1:
        return
    rect: RECT = RECT()
    if GetWindowRect(g_window_handle, rect as i64) != 0:
        g_window_saved_left = rect.left
        g_window_saved_top = rect.top
        g_window_saved_right = rect.right
        g_window_saved_bottom = rect.bottom
    g_window_saved_style = GetWindowLongPtrA(g_window_handle, GWL_STYLE)
    if g_window_saved_style == 0:
        g_window_saved_style = (WS_OVERLAPPEDWINDOW | WS_VISIBLE) as i64
    g_window_saved_valid = 1

fun _window_screen_width() -> i32:
    w: i32 = GetSystemMetrics(SM_CXSCREEN)
    if w <= 0:
        return g_window_width
    return w

fun _window_screen_height() -> i32:
    h: i32 = GetSystemMetrics(SM_CYSCREEN)
    if h <= 0:
        return g_window_height
    return h

fun _window_apply_borderless_fullscreen(mode: i32) -> i32:
    if g_window_handle == 0:
        return 0
    _window_save_windowed_state()
    screen_w: i32 = _window_screen_width()
    screen_h: i32 = _window_screen_height()
    if screen_w <= 0:
        return 0
    if screen_h <= 0:
        return 0
    SetWindowLongPtrA(g_window_handle, GWL_STYLE, (WS_POPUP | WS_VISIBLE) as i64)
    SetWindowPos(g_window_handle, HWND_TOP, 0, 0, screen_w, screen_h, SWP_FRAMECHANGED | SWP_SHOWWINDOW)
    g_window_mode = mode
    g_window_width = screen_w
    g_window_height = screen_h
    g_window_resized = 1
    return 1

fun _window_apply_windowed(width: i32, height: i32) -> i32:
    if g_window_handle == 0:
        return 0
    target_w: i32 = width
    target_h: i32 = height
    if g_window_saved_valid == 1:
        if target_w <= 0:
            target_w = g_window_saved_right - g_window_saved_left
        if target_h <= 0:
            target_h = g_window_saved_bottom - g_window_saved_top
    if target_w <= 0:
        target_w = g_window_width
    if target_h <= 0:
        target_h = g_window_height
    if target_w <= 0:
        target_w = 1280
    if target_h <= 0:
        target_h = 720

    left: i32 = 64
    top: i32 = 64
    if g_window_saved_valid == 1:
        left = g_window_saved_left
        top = g_window_saved_top

    style: i64 = g_window_saved_style
    if style == 0:
        style = (WS_OVERLAPPEDWINDOW | WS_VISIBLE) as i64
    SetWindowLongPtrA(g_window_handle, GWL_STYLE, style)
    SetWindowPos(g_window_handle, HWND_TOP, left, top, target_w, target_h, SWP_FRAMECHANGED | SWP_SHOWWINDOW)
    g_window_mode = WINDOW_MODE_WINDOWED
    g_window_width = target_w
    g_window_height = target_h
    g_window_resized = 1
    g_window_saved_valid = 0
    return 1

fun window_set_mode(mode: i32, width: i32, height: i32) -> i32:
    if mode == WINDOW_MODE_WINDOWED:
        return _window_apply_windowed(width, height)
    if mode == WINDOW_MODE_FULLSCREEN:
        return _window_apply_borderless_fullscreen(mode)
    if mode == WINDOW_MODE_BORDERLESS_FULLSCREEN:
        return _window_apply_borderless_fullscreen(mode)
    return 0

fun window_mode() -> i32:
    return g_window_mode

fun _window_keep_cursor_centered(hwnd: i64):
    if hwnd == 0:
        return
    if g_wnd_mouse_have_last == 0:
        _window_center_cursor(hwnd)
        return
    if g_wnd_mouse_last_x < g_wnd_mouse_center_x - 2:
        _window_center_cursor(hwnd)
        return
    if g_wnd_mouse_last_x > g_wnd_mouse_center_x + 2:
        _window_center_cursor(hwnd)
        return
    if g_wnd_mouse_last_y < g_wnd_mouse_center_y - 2:
        _window_center_cursor(hwnd)
        return
    if g_wnd_mouse_last_y > g_wnd_mouse_center_y + 2:
        _window_center_cursor(hwnd)
        return

fun _window_event_queue_init():
    if g_window_event_hwnds != 0:
        return
    cap64: i64 = g_window_event_capacity as i64
    g_window_event_hwnds = Memory.malloc_zeroed(cap64 * 8)
    g_window_event_types = Memory.malloc_zeroed(cap64 * 4)
    g_window_event_value1s = Memory.malloc_zeroed(cap64 * 4)
    g_window_event_value2s = Memory.malloc_zeroed(cap64 * 4)
    g_window_event_read = 0
    g_window_event_write = 0

fun _window_push_event(hwnd: i64, event_kind: i32, value1: i32, value2: i32):
    if event_kind == WINDOW_EVENT_NONE:
        return
    if g_window_event_hwnds == 0:
        _window_event_queue_init()

    idx: i32 = g_window_event_write
    next: i32 = idx + 1
    if next >= g_window_event_capacity:
        next = 0

    if next == g_window_event_read:
        g_window_event_read = g_window_event_read + 1
        if g_window_event_read >= g_window_event_capacity:
            g_window_event_read = 0

    off8: i64 = (idx as i64) * 8
    off4: i64 = (idx as i64) * 4
    Memory.write_i64(g_window_event_hwnds + off8, hwnd)
    Memory.write_i32(g_window_event_types + off4, event_kind)
    Memory.write_i32(g_window_event_value1s + off4, value1)
    Memory.write_i32(g_window_event_value2s + off4, value2)
    g_window_event_write = next

# ----- WndProc Callback Function -----
# Handles window lifecycle + records mouse-wheel / typed-char events
# into window-local state. Keyboard polling goes via GetAsyncKeyState
# (in the input library). This function has NO dependency on input.
fun WndProc(hWnd: i64, uMsg: i32, wParam: i64, lParam: i64) -> i64:
    new_width: i32 = 0
    new_height: i32 = 0
    wheel_raw: i32 = 0
    wheel_units: f32 = 0.0
    typed_code: i32 = 0
    mouse_x: i32 = 0
    mouse_y: i32 = 0
    mouse_margin: i32 = 48

    # Handle window close message
    if uMsg == WM_CLOSE:
        g_should_close = 1
        _window_push_event(hWnd, WINDOW_EVENT_CLOSE, 0, 0)
        PostQuitMessage(0)
        return 0

    # Handle actual window destruction. This wakes message loops that would
    # otherwise keep a process alive after the native window is gone.
    if uMsg == WM_DESTROY:
        g_should_close = 1
        _window_push_event(hWnd, WINDOW_EVENT_CLOSE, 0, 0)
        PostQuitMessage(0)
        return 0

    # Handle window resize message
    if uMsg == WM_SIZE:
        new_width = (lParam & 65535) as i32
        new_height = ((lParam >> 16) & 65535) as i32
        g_window_width = new_width
        g_window_height = new_height
        g_window_resized = 1
        _window_push_event(hWnd, WINDOW_EVENT_RESIZE, new_width, new_height)
        return 0

    # Handle focus gained
    if uMsg == WM_SETFOCUS:
        g_window_focused = 1
        if g_cursor_locked == 1:
            _window_clip_cursor_to_client(hWnd)
        _window_push_event(hWnd, WINDOW_EVENT_FOCUS, 1, 0)
        return 0

    # Handle focus lost
    if uMsg == WM_KILLFOCUS:
        g_window_focused = 0
        g_wnd_mouse_have_last = 0
        if g_cursor_locked == 1:
            ClipCursor(0)
        _window_push_event(hWnd, WINDOW_EVENT_FOCUS, 0, 0)
        return 0

    if uMsg == WM_INPUT:
        _window_accumulate_raw_mouse(lParam)
        return DefWindowProcA(hWnd, uMsg, wParam, lParam)

    # Relative mouse movement from WM_MOUSEMOVE. This avoids per-frame
    # GetCursorPos polling. It remains as a fallback if Raw Input registration
    # is unavailable.
    if uMsg == WM_MOUSEMOVE:
        mouse_x = (lParam & 65535) as i32
        mouse_y = ((lParam >> 16) & 65535) as i32
        if mouse_x >= 32768:
            mouse_x = mouse_x - 65536
        if mouse_y >= 32768:
            mouse_y = mouse_y - 65536
        if g_cursor_locked == 1:
            if g_wnd_raw_mouse_enabled == 1:
                return 0
            if g_wnd_mouse_have_last == 1:
                g_wnd_mouse_delta_x = g_wnd_mouse_delta_x + (mouse_x - g_wnd_mouse_last_x)
                g_wnd_mouse_delta_y = g_wnd_mouse_delta_y + (mouse_y - g_wnd_mouse_last_y)
            g_wnd_mouse_last_x = mouse_x
            g_wnd_mouse_last_y = mouse_y
            g_wnd_mouse_have_last = 1
            if g_window_width > mouse_margin * 2:
                if g_window_height > mouse_margin * 2:
                    if mouse_x < mouse_margin or mouse_x > g_window_width - mouse_margin or mouse_y < mouse_margin or mouse_y > g_window_height - mouse_margin:
                        g_wnd_mouse_have_last = 0
                        _window_center_cursor(hWnd)
        else:
            g_wnd_mouse_have_last = 0
        return 0

    # Mouse wheel: wParam high word is the signed delta in multiples of
    # WHEEL_DELTA (120). Accumulate into window-local state.
    if uMsg == WM_MOUSEWHEEL:
        wheel_raw = ((wParam >> 16) & 65535) as i32
        # Sign-extend 16-bit signed value stored in a 32-bit register
        if wheel_raw >= 32768:
            wheel_raw = wheel_raw - 65536
        wheel_units = (wheel_raw as f32) / 120.0
        g_wnd_wheel_delta = g_wnd_wheel_delta + wheel_units
        return 0

    # Typed character: wParam is the character code. Store in window's
    # own buffer; consumers drain it via window_consume_typed_chars().
    if uMsg == WM_CHAR:
        typed_code = (wParam & 65535) as i32
        _wnd_ensure_chars_buf()
        if typed_code == 8:
            g_wnd_had_backspace = 1
        elif typed_code >= 32:
            if typed_code <= 126:
                if g_wnd_chars_len < WND_CHARS_CAP:
                    Memory.write_i8(g_wnd_chars_buf + (g_wnd_chars_len as i64), typed_code)
                    g_wnd_chars_len = g_wnd_chars_len + 1
        return 0

    # Default message handling
    return DefWindowProcA(hWnd, uMsg, wParam, lParam)

# ----- Public event getters -----
# Drain the mouse wheel accumulator (returns 0.0 and resets if empty).
fun window_consume_wheel_delta() -> f32:
    v: f32 = g_wnd_wheel_delta
    g_wnd_wheel_delta = 0.0
    return v

fun window_consume_mouse_delta_x() -> i32:
    v: i32 = g_wnd_mouse_delta_x
    g_wnd_mouse_delta_x = 0
    return v

fun window_consume_mouse_delta_y() -> i32:
    v: i32 = g_wnd_mouse_delta_y
    g_wnd_mouse_delta_y = 0
    return v

# Drain the typed-char buffer and return it as a str. Resets on read.
fun window_consume_typed_chars() -> str:
    _wnd_ensure_chars_buf()
    if g_wnd_chars_len <= 0:
        return ""
    Memory.write_i8(g_wnd_chars_buf + (g_wnd_chars_len as i64), 0)
    s: str = g_wnd_chars_buf as str
    g_wnd_chars_len = 0
    return s

# Did the user press backspace since the last consume_typed_chars call?
fun window_consume_backspace() -> i32:
    v: i32 = g_wnd_had_backspace
    g_wnd_had_backspace = 0
    return v

struct WindowEvent:
    hwnd: i64 = 0
    kind: i32 = 0
    value1: i32 = 0
    value2: i32 = 0

fun window_next_event() -> WindowEvent:
    if g_window_event_hwnds == 0:
        return WindowEvent()
    if g_window_event_read == g_window_event_write:
        return WindowEvent()

    idx: i32 = g_window_event_read
    off8: i64 = (idx as i64) * 8
    off4: i64 = (idx as i64) * 4
    event: WindowEvent = WindowEvent(
        hwnd=Memory.read_i64(g_window_event_hwnds + off8),
        kind=Memory.read_i32(g_window_event_types + off4),
        value1=Memory.read_i32(g_window_event_value1s + off4),
        value2=Memory.read_i32(g_window_event_value2s + off4)
    )

    g_window_event_read = g_window_event_read + 1
    if g_window_event_read >= g_window_event_capacity:
        g_window_event_read = 0
    return event

# ----- Window Struct -----
struct Window:
    handle: i64 = 0
    hinstance: i64 = 0
    width: i32 = 0
    height: i32 = 0
    should_close_flag: i32 = 0
    is_resized: i32 = 0
    is_focused: i32 = 1
    vulkan_surface: i64 = 0

# Helper: Create empty Window
fun make_empty_window() -> Window:
    return Window(handle=0 as i64, hinstance=0 as i64, width=0, height=0, should_close_flag=0, is_resized=0, is_focused=1, vulkan_surface=0 as i64)

# Helper: Create empty WNDCLASSEXW with proper types
fun make_empty_wndclassexw() -> WNDCLASSEXW:
    w: WNDCLASSEXW = WNDCLASSEXW(cbSize=80, style=0, lpfnWndProc=0 as i64, cbClsExtra=0, cbWndExtra=0, hInstance=0 as i64, hIcon=0 as i64, hCursor=0 as i64, hbrBackground=0 as i64, lpszMenuName=0 as i64, lpszClassName=0 as i64, hIconSm=0 as i64)
    return w

# ----- Window Implementation -----
attach Window:
    static fun create(title: str, width: i32, height: i32) -> Window:
        if width <= 0 or height <= 0:
            g_last_error = WINDOW_ERROR_INVALID_PARAMETER
            return make_empty_window()

        hinstance: i64 = GetModuleHandleA(0)
        if hinstance == 0:
            g_last_error = WINDOW_ERROR_CREATE_WINDOW
            g_win32_error = GetLastError()
            return make_empty_window()

        if g_class_registered == 0:
            wc: WNDCLASSEXW = WNDCLASSEXW(cbSize=80, style=0, lpfnWndProc=0 as i64, cbClsExtra=0, cbWndExtra=0, hInstance=0 as i64, hIcon=0 as i64, hCursor=0 as i64, hbrBackground=0 as i64, lpszMenuName=0 as i64, lpszClassName=0 as i64, hIconSm=0 as i64)
            wc.cbSize = 80
            wc.style = CS_HREDRAW | CS_VREDRAW | CS_OWNDC
            wc.lpfnWndProc = WndProc as i64
            wc.cbClsExtra = 0
            wc.cbWndExtra = 0
            wc.hInstance = hinstance
            wc.hIcon = 0
            wc.hCursor = LoadCursorA(0, IDC_ARROW)
            wc.hbrBackground = 0
            wc.lpszMenuName = 0
            class_name: str = "DoletWindow"
            wc.lpszClassName = class_name as i64
            wc.hIconSm = 0

            atom: i16 = RegisterClassExA(wc as i64)
            if atom == 0:
                g_last_error = WINDOW_ERROR_REGISTER_CLASS
                g_win32_error = GetLastError()
                return make_empty_window()
            
            g_class_registered = 1
        
        style: i32 = WS_OVERLAPPEDWINDOW | WS_VISIBLE
        class_name_ptr: str = "DoletWindow"

        hwnd: i64 = CreateWindowExA(0, class_name_ptr as i64, title as i64, style, CW_USEDEFAULT, CW_USEDEFAULT, width, height, 0, 0, hinstance, 0)

        if hwnd == 0:
            g_last_error = WINDOW_ERROR_CREATE_WINDOW
            g_win32_error = GetLastError()
            return Window(handle=0 as i64, hinstance=0 as i64, width=0, height=0, should_close_flag=0, is_resized=0, is_focused=1, vulkan_surface=0 as i64)
        
        window: Window = Window(handle=hwnd, hinstance=hinstance, width=width, height=height, should_close_flag=0, is_resized=0, is_focused=1, vulkan_surface=0)

        g_current_window = window as i64
        g_window_handle = hwnd
        g_window_hinstance = hinstance
        g_should_close = 0
        g_window_resized = 0
        g_window_focused = 1
        g_window_width = width
        g_window_height = height
        _window_event_queue_init()
        
        ShowWindow(hwnd, SW_SHOW)
        g_last_error = WINDOW_ERROR_NONE
        
        return window

    static fun open(title: str, width: i32, height: i32) -> i32:
        if g_window_handle != 0:
            Window.shutdown()
        win: Window = Window.create(title, width, height)
        if win.handle == 0:
            return 0
        return 1

    static fun shutdown():
        if g_window_handle == 0:
            return
        win: Window = Window(
            handle=g_window_handle,
            hinstance=g_window_hinstance,
            width=g_window_width,
            height=g_window_height,
            should_close_flag=g_should_close,
            is_resized=g_window_resized,
            is_focused=g_window_focused,
            vulkan_surface=0
        )
        win.destroy()
        _window_raw_mouse_shutdown()
        g_window_handle = 0
        g_window_hinstance = 0

    static fun poll():
        if g_window_handle == 0:
            return
        win: Window = Window(
            handle=g_window_handle,
            hinstance=g_window_hinstance,
            width=g_window_width,
            height=g_window_height,
            should_close_flag=g_should_close,
            is_resized=g_window_resized,
            is_focused=g_window_focused,
            vulkan_surface=0
        )
        win.poll_events()
        g_window_width = win.width
        g_window_height = win.height
        g_window_focused = win.is_focused

    static fun wait():
        if g_window_handle == 0:
            return
        WaitMessage()
        Window.poll()

    static fun wait_timeout(timeout_ms: i32):
        if g_window_handle == 0:
            return
        if timeout_ms <= 0:
            Window.poll()
            return
        MsgWaitForMultipleObjects(0, 0, 0, timeout_ms, QS_ALLINPUT)
        Window.poll()

    static fun should_close() -> i32:
        if g_window_handle == 0:
            return 1
        if g_should_close == 1:
            return 1
        return 0

    static fun running() -> i32:
        if Window.should_close() == 0:
            return 1
        return 0

    static fun request_close():
        g_should_close = 1
        PostQuitMessage(0)

    static fun handle() -> i64:
        return g_window_handle

    static fun hinstance() -> i64:
        return g_window_hinstance

    static fun width() -> i32:
        if g_window_handle == 0:
            return 0
        rect: RECT = RECT()
        GetClientRect(g_window_handle, rect as i64)
        g_window_width = rect.right - rect.left
        return g_window_width

    static fun height() -> i32:
        if g_window_handle == 0:
            return 0
        rect: RECT = RECT()
        GetClientRect(g_window_handle, rect as i64)
        g_window_height = rect.bottom - rect.top
        return g_window_height

    static fun set_mode(mode: i32, width: i32, height: i32) -> i32:
        return window_set_mode(mode, width, height)

    static fun mode() -> i32:
        return window_mode()

    static fun focused() -> i32:
        return g_window_focused

    static fun next_event() -> WindowEvent:
        return window_next_event()
    
    fun destroy(self):
        if self.handle != 0:
            g_should_close = 1
            DestroyWindow(self.handle)
            PostQuitMessage(0)
            if g_window_handle == self.handle:
                g_window_handle = 0
                g_window_hinstance = 0
            self.handle = 0
        
        if g_current_window == self as i64:
            g_current_window = 0
        
        if g_class_registered == 1:
            class_name: str = "DoletWindow"
            UnregisterClassA(class_name as i64, self.hinstance)
            g_class_registered = 0
        
        self.hinstance = 0
        self.width = 0
        self.height = 0
        self.should_close_flag = 1
        self.is_resized = 0
        self.is_focused = 0
        self.vulkan_surface = 0
    
    fun poll_events(self):
        if self.handle == 0:
            return

        msg: MSG = MSG(hwnd=0 as i64, message=0, padding1=0, wParam=0 as i64, lParam=0 as i64, time=0, pt_x=0, pt_y=0, padding2=0)
        
        while PeekMessageA(msg as i64, 0, 0, 0, PM_REMOVE) != 0:
            if msg.message == WM_QUIT:
                g_should_close = 1
                self.should_close_flag = 1
            else:
                TranslateMessage(msg as i64)
                DispatchMessageA(msg as i64)

        if g_cursor_locked == 1:
            if g_window_focused == 1:
                _window_clip_cursor_to_client(self.handle)
                if g_wnd_raw_mouse_enabled == 0:
                    _window_keep_cursor_centered(self.handle)
        
        if g_should_close == 1:
            self.should_close_flag = 1
        if g_window_resized == 1:
            self.width = g_window_width
            self.height = g_window_height
            self.is_resized = 1
        self.is_focused = g_window_focused
    
    fun get_width(self) -> i32:
        if g_window_resized == 1:
            self.width = g_window_width
            self.height = g_window_height
            self.is_resized = 1
        
        rect: RECT = RECT()
        GetClientRect(self.handle, rect as i64)
        actual_width: i32 = rect.right - rect.left
        self.width = actual_width
        return actual_width
    
    fun get_height(self) -> i32:
        if g_window_resized == 1:
            self.width = g_window_width
            self.height = g_window_height
            self.is_resized = 1
        
        rect: RECT = RECT()
        GetClientRect(self.handle, rect as i64)
        actual_height: i32 = rect.bottom - rect.top
        self.height = actual_height
        return actual_height
    
    fun set_size(self, width: i32, height: i32):
        if self.handle == 0:
            return
        flags: i32 = SWP_NOMOVE | SWP_NOZORDER
        SetWindowPos(self.handle, 0, 0, 0, width, height, flags)
        self.width = width
        self.height = height
    
    fun set_title(self, title: str):
        if self.handle == 0:
            return
        SetWindowTextA(self.handle, title as i64)
    
    fun show(self):
        if self.handle == 0:
            return
        ShowWindow(self.handle, SW_SHOW)
    
    fun hide(self):
        if self.handle == 0:
            return
        ShowWindow(self.handle, SW_HIDE)
    
    fun was_resized(self) -> i32:
        if g_window_resized == 1:
            self.is_resized = 1
            self.width = g_window_width
            self.height = g_window_height
        return self.is_resized
    
    fun reset_resize_flag(self):
        self.is_resized = 0
        g_window_resized = 0
    
    fun has_focus(self) -> i32:
        self.is_focused = g_window_focused
        return self.is_focused
    
    fun get_handle(self) -> i64:
        return self.handle
    
    fun get_hinstance(self) -> i64:
        return self.hinstance

    # ----- Vulkan Surface Methods -----
    fun create_vulkan_surface(self, instance: i64) -> i64:
        if self.handle == 0 or instance == 0:
            g_last_error = WINDOW_ERROR_INVALID_HANDLE
            return 0

        create_info: VkWin32SurfaceCreateInfoKHR = VkWin32SurfaceCreateInfoKHR(sType=1000009000, padding1=0, pNext=0 as i64, flags=0, padding2=0, hinstance=0 as i64, hwnd=0 as i64)
        create_info.sType = VK_STRUCTURE_TYPE_WIN32_SURFACE_CREATE_INFO_KHR
        create_info.pNext = 0
        create_info.flags = 0
        create_info.hinstance = self.hinstance
        create_info.hwnd = self.handle
        
        surface_ptr: i64 = Memory.malloc(8)
        if surface_ptr == 0:
            g_last_error = WINDOW_ERROR_VULKAN_SURFACE
            return 0
        
        Memory.write_i64(surface_ptr, 0)
        result: i32 = vkCreateWin32SurfaceKHR(instance, create_info as i64, 0, surface_ptr)
        
        if result != VK_SUCCESS:
            g_last_error = WINDOW_ERROR_VULKAN_SURFACE
            g_win32_error = result
            Memory.free(surface_ptr)
            return 0
        
        surface: i64 = Memory.read_i64(surface_ptr)
        Memory.free(surface_ptr)
        self.vulkan_surface = surface
        return surface
    
    static fun get_required_extension_1() -> str:
        return "VK_KHR_surface"
    
    static fun get_required_extension_2() -> str:
        return "VK_KHR_win32_surface"
    
    fun destroy_vulkan_surface(self, instance: i64):
        if self.vulkan_surface == 0 or instance == 0:
            return
        vkDestroySurfaceKHR(instance, self.vulkan_surface, 0)
        self.vulkan_surface = 0

    fun create_software_surface(self) -> WindowSoftwareSurface:
        if self.handle == 0:
            g_last_error = WINDOW_ERROR_INVALID_HANDLE
            return WindowSoftwareSurface()

        return WindowSoftwareSurface(hwnd=self.handle, scratch_buffer=0, scratch_size=0, valid=1)
    
    fun get_vulkan_surface(self) -> i64:
        return self.vulkan_surface
    
    # ----- Event Waiting Methods -----
    # Block until an event arrives, then process all pending events
    # CPU usage: ~0% while waiting
    # Use case: GUI applications that don't need constant updates
    fun wait_events(self):
        if self.handle == 0:
            return
        
        # Block until a message arrives
        WaitMessage()
        
        # Process all pending events
        self.poll_events()
    
    # Wait for an event or timeout, then process all pending events
    # CPU usage: ~0% while waiting
    # Use case: Games with frame rate limiting, hybrid applications
    # timeout_ms: Maximum wait time in milliseconds
    #   - 0 or negative: behaves like poll_events() (non-blocking)
    #   - positive: waits up to timeout_ms for an event
    fun wait_events_timeout(self, timeout_ms: i32):
        if self.handle == 0:
            return
        
        # If timeout is 0 or negative, just poll (non-blocking)
        if timeout_ms <= 0:
            self.poll_events()
            return
        
        # Wait for message or timeout
        # nCount=0, pHandles=0, fWaitAll=0, dwMilliseconds=timeout_ms, dwWakeMask=QS_ALLINPUT
        MsgWaitForMultipleObjects(0, 0, 0, timeout_ms, QS_ALLINPUT)
        
        # Process all pending events
        self.poll_events()

# ----- Helper Functions -----
fun get_last_error() -> i32:
    return g_last_error

fun get_win32_error() -> i32:
    return g_win32_error

fun clear_error():
    g_last_error = WINDOW_ERROR_NONE
    g_win32_error = 0

fun set_error(error_code: i32, win32_error: i32):
    g_last_error = error_code
    g_win32_error = win32_error

# ----- Cursor Control Functions -----
fun set_cursor_visible(visible: i32):
    if visible == 1 and g_cursor_visible == 0:
        ShowCursor(1)
        g_cursor_visible = 1
    elif visible == 0 and g_cursor_visible == 1:
        ShowCursor(0)
        g_cursor_visible = 0

fun is_cursor_visible() -> i32:
    return g_cursor_visible

fun set_cursor_locked(locked: i32, window_handle: i64):
    if locked == 1 and g_cursor_locked == 0:
        _window_clip_cursor_to_client(window_handle)
        _window_enable_raw_mouse()
        g_cursor_locked = 1
    elif locked == 0 and g_cursor_locked == 1:
        ClipCursor(0)
        g_cursor_locked = 0

fun is_cursor_locked() -> i32:
    return g_cursor_locked

fun set_cursor_position(x: i32, y: i32):
    SetCursorPos(x, y)

# =====================================================================
#  Framebuffer present
# =====================================================================
# Callers pass a BGRA8888 framebuffer; this blits it to the window DC
# with a single SetDIBitsToDevice. Keeps all GDI knowledge inside the
# window package so drawing libraries (ui, etc.) stay platform-free.

@stack
struct _PresentBmi:
    biSize:          i32 = 40
    biWidth:         i32 = 0
    biHeight:        i32 = 0   # negative = top-down
    biPlanes:        i16 = 1
    biBitCount:      i16 = 32
    biCompression:   i32 = 0   # BI_RGB
    biSizeImage:     i32 = 0
    biXPelsPerMeter: i32 = 0
    biYPelsPerMeter: i32 = 0
    biClrUsed:       i32 = 0
    biClrImportant:  i32 = 0
    bmiColors:       i32 = 0

fun window_present_framebuffer(hwnd: i64, data: i64, width: i32, height: i32, pitch: i32) -> i32:
    if hwnd == 0 or data == 0:
        return 0
    if width <= 0 or height <= 0:
        return 0
    zero: i32 = width - width
    hdc: i64 = GetDC(hwnd)
    if hdc == 0:
        return 0
    bmi: _PresentBmi = _PresentBmi()
    bmi.biSize = 40
    bmi.biWidth = width
    bmi.biHeight = zero - height   # top-down
    bmi.biPlanes = 1
    bmi.biBitCount = 32
    bmi.biCompression = zero
    SetDIBitsToDevice(hdc, zero, zero, width, height, zero, zero, zero, height, data, bmi as i64, zero)
    ReleaseDC(hwnd, hdc)
    return 1

# =====================================================================
#  Client-space mouse position
# =====================================================================
# Wraps GetCursorPos + ScreenToClient so consumers (ui, eqoi, game code)
# don't need their own extern lib "user32" declaration just to read
# where the cursor is inside the window.

@stack
struct _ClientPoint:
    x: i32 = 0
    y: i32 = 0

fun window_client_mouse_x(hwnd: i64) -> i32:
    if hwnd == 0:
        return 0
    p: _ClientPoint = _ClientPoint()
    if GetCursorPos(p as i64) == 0:
        return 0
    ScreenToClient(hwnd, p as i64)
    return p.x

fun window_client_mouse_y(hwnd: i64) -> i32:
    if hwnd == 0:
        return 0
    p: _ClientPoint = _ClientPoint()
    if GetCursorPos(p as i64) == 0:
        return 0
    ScreenToClient(hwnd, p as i64)
    return p.y
