# Window Module Metadata
# Target-neutral native window API with platform-specific backends

[info]
name = window
version = 1.6.0
description = Target-neutral native window API with Vulkan surfaces and fast native software-framebuffer presentation on Windows and X11.

[libs]
windows = window_raw_input.lib

[dlls]
# No runtime DLLs to copy for the Windows backend; it uses system DLLs.

[dependencies]
# Raw OS bindings are imported from library/platform/<os>.

# Platform-specific linking information
[link.windows]
system_libs = user32, gdi32, kernel32

[link.linux]
# Linux uses X11 for windowing
flags = -lX11

[link.macos]
# macOS uses Cocoa framework
frameworks = Cocoa, Metal
