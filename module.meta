# Window Module Metadata
# Target-neutral native window API with platform-specific backends

[info]
name = window
version = 1.8.0
layer = os
description = Target-neutral native window API with Vulkan surfaces and software presentation on Windows, native Wayland, and X11/XWayland.

[libs]
windows = window_raw_input.lib
linux = libdolet_window_linux.a

[dlls]
# No runtime DLLs to copy for the Windows backend; it uses system DLLs.

[dependencies]
# Raw OS bindings are imported from library/platform/<os>.

# Platform-specific linking information
[link.windows]
system_libs = user32, gdi32, kernel32

[link.linux]
# Wayland is preferred at runtime; X11 remains a compatibility fallback.
flags = -ldolet_window_linux -lwayland-client -lwayland-cursor -lxkbcommon -lX11

[link.macos]
# macOS uses Cocoa framework
frameworks = Cocoa, Metal
